# Run outputs: large, and regenerated by run_expert.py and verify_backends.py.
outputs/
# Vendor SDK and controller-image extracts: third-party code, and the image holds
# credential-like fields. Never commit; copy from the original machine instead.
sdk_review/
# Machine details (hosts, internal paths): the repository is public.
CLAUDE.local.md
# Rebuildable caches are ignored where they live: robots/franzi/assets/.gitignore
# (appearance, link hulls) and scenes/<scene>/assets/.gitignore (prop caches).
# Blender prop pipeline (tools/blender/): the build scripts rebuild each prop's
# .blend sources; the QA renders (render*.png), logs and reports are Codex's run
# records. Props live in assets/props/ and scenes/<scene>/assets/.
*.blend
*.blend1
assets/props/*/render*.png
scenes/*/assets/*/render*.png
tools/blender/_qa/
tools/blender/*.log
tools/blender/task[0-9]*
tools/blender/commands.txt
__pycache__/
.pytest_cache/
.ruff_cache/
.DS_Store
