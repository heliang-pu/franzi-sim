# Run outputs: large, and regenerated by run_expert.py and verify_backends.py.
outputs/
# Vendor SDK and controller-image extracts: third-party code, and the image holds
# credential-like fields. Never commit; copy from the original machine instead.
sdk_review/
# Rebuildable caches (appearance.py, fittings.py, convert_pybullet_assets.py).
assets/appearance/painted/
assets/appearance/wordmark/
assets/appearance/fittings/
assets/derived/
# Unused leftovers directly under assets/appearance/.
assets/appearance/head_*.stl
assets/appearance/head_parts.json
assets/appearance/inovance_wordmark.png
# Blender prop pipeline (tools/blender/): the build scripts rebuild each prop's
# source.blend; the QA renders, logs and reports are Codex's run records.
assets/props/*/source.blend
*.blend1
tools/blender/_qa/
tools/blender/*.log
tools/blender/task[0-9]*
tools/blender/commands.txt
__pycache__/
.pytest_cache/
.ruff_cache/
.DS_Store
